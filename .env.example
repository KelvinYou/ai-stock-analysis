# Python (CLI / API / worker / backtest) env — copy to `.env`.
#
# This file is deliberately server-only. The web app has its own template at
# `web/.env.example`, because it must never see SUPABASE_SERVICE_ROLE_KEY: the
# service key bypasses RLS, and anything reachable from the browser bundle is
# public. Do not merge the two.
#
# Every variable below is read by `Settings.from_env` in
# src/stock_analysis/config.py — that map is the authoritative list.

# Runtime profile. Production rejects local in-process job state.
APP_ENV=development

# Storage backend: local (offline/tests) or supabase (cloud-first).
STORAGE_BACKEND=local

# Only used when STORAGE_BACKEND=local.
STOCK_DATA_DIR=data

# Required when STORAGE_BACKEND=supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-key
SUPABASE_SCHEMA=public

# Required for the public FastAPI control plane in production. This protects
# your API; it is not the same credential as ANTHROPIC_API_KEY below.
API_BEARER_TOKEN=

# Admission and runtime safety limits. The quota counts accepted attempts (a
# provider failure may already have spent tokens) and resets at midnight in
# this IANA timezone. Increase only after observing real run duration.
ANALYSIS_MAX_DAILY_RUNS=10
ANALYSIS_QUOTA_TIMEZONE=Asia/Kuala_Lumpur
# Local backend only. Cloud enqueue accepts pending work; worker replicas set
# actual cloud parallelism.
ANALYSIS_MAX_CONCURRENT_RUNS=1
ANALYSIS_MAX_RUN_SECONDS=1800

# Worker identity and poll interval. ANALYSIS_WORKER_ID is what lands in
# analysis_runs.worker_id, so make it identifiable per process.
ANALYSIS_WORKER_ID=stock-worker-1
ANALYSIS_WORKER_POLL_SECONDS=5
ANALYSIS_WORKER_LEASE_SECONDS=900
ANALYSIS_WORKER_HEARTBEAT_SECONDS=60

# Worker-only outbound LLM credential. Do not put this in the web app or a
# public repository. Local interactive development may use `claude login`;
# production containers must use a non-interactive provider credential.
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
