# Next.js env — copy to `web/.env.local`.
#
# Preferred production mode: the Next.js server reads public dashboard data
# through FastAPI. These variables are server-only; never prefix them with
# NEXT_PUBLIC_ because the bearer token must not enter the browser bundle.
#
# SUPABASE_SERVICE_ROLE_KEY belongs in the backend/worker secret store and must
# never appear here.
#
STOCK_ANALYSIS_API_URL=http://localhost:8000
STOCK_ANALYSIS_API_TOKEN=replace-with-api-bearer-token

# Legacy direct-Supabase mode. Keep these unset when using FastAPI. They remain
# as a local transition fallback and use only the publishable/anon key.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Absolute base for OG/Twitter card and QR URLs — scrapers ignore relative ones.
# Defaults to http://localhost:3000 (lib/site.ts) when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Accepted as fallbacks by data.ts / watchlist.ts, but intentionally left unset:
# both modules import `node:fs` and only ever run server-side, so the NEXT_PUBLIC_
# variants would inline the key into the browser bundle with no reader. Set them
# only if a future client component genuinely needs to query Supabase directly.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local offline mode only — paths are relative to web/.
# STOCK_DATA_DIR=../data
# STOCK_TICKERS_FILE=../tickers.txt
# STOCK_PIPELINE_FILE=../pipeline.json
