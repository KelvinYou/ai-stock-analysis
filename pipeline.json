{
  "_comment": [
    "Canonical description of ticker analysis and optional portfolio research — single source of truth.",
    "Consumers:",
    "  1. web/app/about  — renders it as an SVG flowchart (web/lib/pipeline.ts)",
    "  2. architecture.md — mermaid block regenerated by scripts/sync_architecture.py",
    "Edit this file, then run `python scripts/sync_architecture.py` so the docs follow.",
    "Node `lines` are display detail; `tone` picks the accent (data/agent/bull/bear/output/muted).",
    "Edges are explicit domain dependencies; rows control layout only. Conditional edges mark optional inputs or stages."
  ],
  "stages": [
    {
      "id": "L1",
      "layer": "Layer 1",
      "title": "Data Ingestion",
      "note": "Deterministic inputs — no LLM",
      "rows": [
        [
          {
            "id": "UNI",
            "label": "Ticker universes",
            "lines": [
              "S&P 500 · NASDAQ 100 · FBM KLCI",
              "scraped from Wikipedia"
            ],
            "tone": "muted",
            "dashed": true,
            "edgeLabel": "drives bulk fetch"
          }
        ],
        [
          {
            "id": "US",
            "label": "US market data",
            "lines": [
              "yfinance · adjusted technical bars",
              "dated financial history · plain Close"
            ],
            "tone": "data"
          },
          {
            "id": "MY",
            "label": "Bursa / KLSE",
            "lines": [
              "yfinance via .KL suffix",
              "BURSA_ALIASES name → code"
            ],
            "tone": "data"
          },
          {
            "id": "REPLAY",
            "label": "Historical replay",
            "lines": [
              "SEC periods · revisions",
              "dated valuation basis",
              "API / session backtests"
            ],
            "tone": "muted"
          }
        ]
      ],
      "sink": {
        "id": "SDL",
        "label": "Analysis Store",
        "lines": [
          "Supabase / local backend",
          "bars · dated evidence",
          "research artifacts · runs"
        ],
        "tone": "data"
      }
    },
    {
      "id": "PREP",
      "layer": "Layer 1.5",
      "title": "Input Isolation",
      "note": "Deterministic evidence preparation",
      "rows": [
        [
          {
            "id": "INPUT",
            "label": "Sealed run input",
            "lines": [
              "dated evidence · recent news",
              "immutable SHA-256 · cloud resume"
            ],
            "tone": "data"
          }
        ]
      ]
    },
    {
      "id": "L2",
      "layer": "Layer 2",
      "title": "Analyst Agents",
      "note": "four concurrent analysts",
      "model": "Haiku",
      "modelKey": "quick_think_model",
      "rows": [
        [
          {
            "id": "FUN",
            "label": "Fundamentals",
            "lines": [
              "periods · growth · debt",
              "dated P/E · evidence gaps"
            ],
            "tone": "agent"
          },
          {
            "id": "SEN",
            "label": "Sentiment",
            "lines": [
              "news · analyst tone"
            ],
            "tone": "agent"
          },
          {
            "id": "TEC",
            "label": "Technical",
            "lines": [
              "RSI · MACD · volume"
            ],
            "tone": "agent"
          },
          {
            "id": "MAC",
            "label": "Macro / FX",
            "lines": [
              "Fed · rates · FX impact"
            ],
            "tone": "agent"
          }
        ]
      ]
    },
    {
      "id": "L3",
      "layer": "Layer 3",
      "title": "Adversarial Debate",
      "note": "3 rounds by default",
      "model": "Opus",
      "modelKey": "deep_think_model",
      "pairLabel": "rebut · concede · refine",
      "rows": [
        [
          {
            "id": "BULL",
            "label": "Bull researcher",
            "lines": [
              "best case · catalysts · upside"
            ],
            "tone": "bull"
          },
          {
            "id": "BEAR",
            "label": "Bear researcher",
            "lines": [
              "risks · headwinds · downside"
            ],
            "tone": "bear"
          }
        ]
      ]
    },
    {
      "id": "L35",
      "layer": "Layer 3.5",
      "title": "Research Manager",
      "note": "optional adjudication",
      "model": "Sonnet",
      "modelKey": "research_manager_model",
      "rows": [
        [
          {
            "id": "RM",
            "label": "ResearchManager",
            "lines": [
              "winning side · thesis",
              "strongest counterexample",
              "invalidation conditions · evidence gaps"
            ],
            "tone": "agent"
          }
        ]
      ]
    },
    {
      "id": "CTX",
      "layer": "Supporting context",
      "title": "Outcome Memory",
      "note": "optional · resolved exits only",
      "rows": [
        [
          {
            "id": "MEM",
            "label": "Outcome Memory",
            "lines": [
              "cloud/local append-only outcomes",
              "hit rate · conviction calibration",
              "feeds context into synthesis"
            ],
            "tone": "muted"
          }
        ]
      ]
    },
    {
      "id": "L4",
      "layer": "Layer 4",
      "title": "Synthesis",
      "note": "synthesis then deterministic risk",
      "model": "Sonnet",
      "modelKey": "synthesis_model",
      "rows": [
        [
          {
            "id": "SYN",
            "label": "SynthesizerAgent",
            "lines": [
              "reports · debate · verdict",
              "optional outcome memory"
            ],
            "tone": "agent"
          }
        ],
        [
          {
            "id": "GATE",
            "label": "Consensus + actionability",
            "lines": [
              "four-report denominator",
              "cap raw model conviction",
              "neutral is a valid result"
            ],
            "tone": "data"
          }
        ],
        [
          {
            "id": "RISK",
            "label": "RiskChecker",
            "lines": [
              "shared production/session gate",
              "finite positive ATR · ordered levels"
            ],
            "tone": "data"
          }
        ]
      ]
    },
    {
      "id": "L5",
      "layer": "Layer 5",
      "title": "Portfolio Research",
      "note": "optional completed-run batch · deterministic · US/USD",
      "rows": [
        [
          {
            "id": "RANK",
            "label": "Run-bound allocator",
            "lines": [
              "same-session sealed inputs",
              "12-month momentum · top three"
            ],
            "tone": "data"
          }
        ],
        [
          {
            "id": "WEIGHTS",
            "label": "Nine target-weight views",
            "lines": [
              "hold · allocator · FT · AI",
              "fixed sleeves · rejected signals keep cash"
            ],
            "tone": "data"
          }
        ],
        [
          {
            "id": "COHORT",
            "label": "Forward cohort collector",
            "lines": [
              "seal before entry · mature-only scoring",
              "daily equity · costs · paired uncertainty"
            ],
            "tone": "muted"
          }
        ]
      ]
    }
  ],
  "output": {
    "id": "OUT",
    "label": "Briefing",
    "lines": [
      "conviction −1.00…+1.00",
      "entry · stop · targets · risk"
    ],
    "tone": "output"
  },
  "consumers": [
    {
      "id": "DASH",
      "label": "Next.js screener",
      "lines": [
        "server-side FastAPI client",
        "one sortable row per ticker"
      ],
      "tone": "muted"
    },
    {
      "id": "API",
      "label": "FastAPI",
      "lines": [
        "analyze · completed run reads",
        "POST /api/v1/portfolio-plans"
      ],
      "tone": "muted"
    },
    {
      "id": "BT",
      "label": "Backtester",
      "lines": [
        "sealed replay · costs",
        "strict hold · uncertainty"
      ],
      "tone": "muted"
    }
  ],
