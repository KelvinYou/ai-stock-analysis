{
  "_comment": [
    "Canonical description of the 4-layer analysis pipeline — the single source of truth.",
    "Consumers:",
    "  1. web/app/about  — renders it as an SVG flowchart (web/lib/pipeline.ts)",
    "  2. architecture.md — mermaid block regenerated by scripts/sync_architecture.py",
    "Edit this file, then run `python scripts/sync_architecture.py` so the docs follow.",
    "Node `lines` are display detail; `tone` picks the accent (data/agent/bull/bear/output/muted)."
  ],
  "stages": [
    {
      "id": "L1",
      "layer": "Layer 1",
      "title": "Data Ingestion",
      "note": "Deterministic fetchers — no LLM",
      "rows": [
        [
          {
            "id": "UNI",
            "label": "Ticker universes",
            "lines": ["S&P 500 · NASDAQ 100 · FBM KLCI", "scraped from Wikipedia"],
            "tone": "muted",
            "dashed": true,
            "edgeLabel": "drives bulk fetch"
          }
        ],
        [
          {
            "id": "US",
            "label": "US market data",
            "lines": ["yfinance · price history", "financials · analyst recs · news"],
            "tone": "data"
          },
          {
            "id": "MY",
            "label": "Bursa / KLSE",
            "lines": ["yfinance via .KL suffix", "BURSA_ALIASES name → code"],
            "tone": "data"
          }
        ]
      ],
      "sink": {
        "id": "SDL",
        "label": "DataStore",
        "lines": [
          "flat per-ticker layout",
          "price_history.csv · fundamentals · technicals",
          "reports · verdict · briefing · outcomes"
        ],
        "tone": "data"
      }
    },
    {
      "id": "L2",
      "layer": "Layer 2",
      "title": "Analyst Agents",
      "note": "four agents run concurrently",
      "model": "Haiku",
      "modelKey": "quick_think_model",
      "rows": [
        [
          {
            "id": "FUN",
            "label": "Fundamentals",
            "lines": ["P/E · margins · debt"],
            "tone": "agent"
          },
          {
            "id": "SEN",
            "label": "Sentiment",
            "lines": ["news · social · tone"],
            "tone": "agent"
          },
          {
            "id": "TEC",
            "label": "Technical",
            "lines": ["RSI · MACD · volume"],
            "tone": "agent"
          },
          {
            "id": "MAC",
            "label": "Macro / FX",
            "lines": ["Fed · rates · FX impact"],
            "tone": "agent"
          }
        ]
      ]
    },
    {
      "id": "L3",
      "layer": "Layer 3",
      "title": "Adversarial Debate",
      "note": "3 rounds by default",
      "model": "Opus",
      "modelKey": "deep_think_model",
      "pairLabel": "rebut · concede · refine",
      "rows": [
        [
          {
            "id": "BULL",
            "label": "Bull researcher",
            "lines": ["best case · catalysts · upside"],
            "tone": "bull"
          },
          {
            "id": "BEAR",
            "label": "Bear researcher",
            "lines": ["risks · headwinds · downside"],
            "tone": "bear"
          }
        ]
      ]
    },
    {
      "id": "L35",
      "layer": "Layer 3.5",
      "title": "Research Manager",
      "note": "rules on the debate — does not re-argue it",
      "model": "Sonnet",
      "modelKey": "research_manager_model",
      "rows": [
        [
          {
            "id": "RM",
            "label": "ResearchManager",
            "lines": [
              "winning side · thesis",
              "strongest counterexample",
              "invalidation conditions · evidence gaps"
            ],
            "tone": "agent"
          }
        ]
      ]
    },
    {
      "id": "L4",
      "layer": "Layer 4",
      "title": "Synthesis",
      "note": "writes the briefing; convergence is computed, not authored",
      "model": "Sonnet",
      "modelKey": "synthesis_model",
      "rows": [
        [
          {
            "id": "SYN",
            "label": "SynthesizerAgent",
            "lines": ["merges reports + verdict + memory", "research view · conviction"],
            "tone": "agent"
          },
          {
            "id": "RISK",
            "label": "RiskChecker",
            "lines": ["deterministic entry/stop/target", "drawdown · risk-reward"],
            "tone": "data"
          }
        ]
      ]
    },
    {
      "id": "L5",
      "layer": "Layer 5",
      "title": "Portfolio Risk Gate",
      "note": "deterministic — reads real holdings",
      "rows": [
        [
          {
            "id": "GATE",
            "label": "PortfolioGate",
            "lines": [
              "risk budget → stop distance → size",
              "single / sector / USD exposure caps",
              "APPROVE · WATCH · REDUCE · REJECT"
            ],
            "tone": "data"
          }
        ]
      ]
    },
    {
      "id": "L6",
      "layer": "Layer 6",
      "title": "Outcome Memory",
      "note": "deterministic — closes the loop; exit-date gated against leakage",
      "rows": [
        [
          {
            "id": "MEM",
            "label": "OutcomeStore",
            "lines": [
              "realized return per resolved call",
              "hit rate · conviction calibration",
              "feeds back into Layer 4"
            ],
            "tone": "muted"
          }
        ]
      ]
    }
  ],
  "output": {
    "id": "OUT",
    "label": "Briefing",
    "lines": [
      "research view · conviction −1.00…+1.00",
      "trade decision · entry · stop · TP1 / TP2",
      "position size as % of equity sleeve"
    ],
    "tone": "output"
  },
  "consumers": [
    {
      "id": "DASH",
      "label": "Next.js screener",
      "lines": ["one sortable row per ticker"],
      "tone": "muted"
    },
    {
      "id": "API",
      "label": "FastAPI",
      "lines": ["POST /analyze · GET /status"],
      "tone": "muted"
    },
    {
      "id": "BT",
      "label": "Backtester",
      "lines": ["hit rate vs realized move"],
      "tone": "muted"
    }
  ]
}
